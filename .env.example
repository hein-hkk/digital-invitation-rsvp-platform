# Obtain these non-production values from `pnpm db:start` or a separate preview project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; use the local Supabase value in an ignored .env.local file.
SUPABASE_SERVICE_ROLE_KEY=

# Future security modules consume separate, locally generated non-production keys.
INVITATION_TOKEN_HASH_KEY=
INVITATION_TOKEN_ENCRYPTION_KEY_V1=
INVITATION_TOKEN_ACTIVE_KEY_VERSION=V1

APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
